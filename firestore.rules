rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && adminDoc().data.role == 'admin';
    }

    function canDeleteProducts() {
      return isAdmin()
        && ('permissions' in adminDoc().data)
        && adminDoc().data.permissions.canDeleteProducts == true;
    }

    function validCustomerProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'displayname',
          'base64avatar',
          'uid',
          'phone',
          'role',
          'geopoint'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.phone is string
        && (request.resource.data.phone.size() == 0
          || (request.resource.data.phone.size() >= 8
            && request.resource.data.phone.size() <= 20))
        && (!('geopoint' in request.resource.data)
          || request.resource.data.geopoint is latlng)
        && (!('role' in request.resource.data)
          || request.resource.data.role == 'customer');
    }

    function validCartItem() {
      return request.resource.data.keys().hasOnly([
          'productId',
          'name',
          'description',
          'shortDescription',
          'base64Image',
          'unit',
          'price',
          'stock',
          'quantity',
          'addedAt',
          'updatedAt'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0;
    }

    function validOrderCreate() {
      return request.resource.data.keys().hasOnly([
          'orderNo',
          'userId',
          'userName',
          'userPhone',
          'orderType',
          'items',
          'subtotal',
          'discount',
          'deliveryFee',
          'deliveryDistanceMeters',
          'deliveryLocation',
          'shopLocation',
          'grandTotal',
          'status',
          'paymentMethod',
          'paymentStatus',
          'pickupInfo',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod in ['promptpay', 'cash']
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.userPhone is string
        && request.resource.data.userPhone.size() >= 8
        && request.resource.data.userPhone.size() <= 20
        && request.resource.data.orderType in ['pickup', 'delivery']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && (!('deliveryFee' in request.resource.data)
          || (request.resource.data.deliveryFee is number
            && request.resource.data.deliveryFee >= 0))
        && request.resource.data.grandTotal is number
        && request.resource.data.grandTotal >= 0;
    }

    function validCustomerPaymentSlipUpdate() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status != 'completed'
        && resource.data.status != 'cancelled'
        && resource.data.paymentStatus in ['unpaid', 'rejected']
        && (!('paymentMethod' in resource.data)
          || resource.data.paymentMethod == 'promptpay')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'paymentSlipBase64',
            'paymentStatus',
            'paymentSlipUploadedAt',
            'updatedAt'
          ])
        && request.resource.data.paymentStatus == 'waiting_verify'
        && request.resource.data.paymentSlipBase64 is string
        && request.resource.data.paymentSlipBase64.size() > 0
        && request.resource.data.paymentSlipBase64.size() <= 1048487;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && validCustomerProfile(userId));
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayname', 'base64avatar', 'phone', 'geopoint'])
          && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
              && (request.resource.data.phone.size() == 0
                || (request.resource.data.phone.size() >= 8
                  && request.resource.data.phone.size() <= 20))))
          && (!('geopoint' in request.resource.data)
            || request.resource.data.geopoint is latlng)
          && (!('uid' in request.resource.data)
            || request.resource.data.uid == userId));
      allow delete: if isOwner(userId) || isAdmin();

      match /cart/{cartId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validCartItem();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /product/{productId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow delete: if canDeleteProducts();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stock'])
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && request.resource.data.stock <= resource.data.stock);
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && validOrderCreate();
      allow update: if validCustomerPaymentSlipUpdate()
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status',
              'paymentStatus',
              'paymentVerifiedAt',
              'paymentRejectedAt',
              'cashCollectedAt',
              'cashCollectedBy',
              'paidAt',
              'stockRestoredAt',
              'lastUpdatedBy',
              'updatedAt'
            ]));
      allow delete: if isAdmin();
    }

    match /adminAuditLogs/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'action',
          'targetCollection',
          'targetId',
          'adminUid',
          'adminEmail',
          'data',
          'createdAt'
        ])
        && request.resource.data.action is string
        && request.resource.data.targetCollection is string
        && request.resource.data.targetId is string
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
